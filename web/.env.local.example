# Same Supabase project the CLI uses.
NEXT_PUBLIC_SUPABASE_URL=https://gcopgofkkqljgmgllepz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated GitHub usernames allowed to sign in.
ALLOWED_GITHUB_LOGINS=

# repos.id row this deployment shows on the board (one deployment = one repo).
COLLAB_REPO_ID=

# Fine-grained GitHub PAT, scoped to this repo only. contents:write,
# pull_requests:write. Migrate to a GitHub App once there's a second user.
GITHUB_PAT=
